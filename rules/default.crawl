# CrawlWe Default Parser Rules
# This file defines the parsing rules for CSS, JS, and HTML analysis

@css {
    # Animation detection
    rule "animations" {
        match /@keyframes\s+([a-zA-Z0-9_-]+)/ -> emit CSS_KEYFRAME($1)
        match /animation\s*:\s*([^;]+);/ -> emit CSS_ANIMATION($1)
        match /animation-name\s*:\s*([^;]+);/ -> emit CSS_ANIMATION_NAME($1)
    }

    # Transition detection
    rule "transitions" {
        match /transition\s*:\s*([^;]+);/ -> emit CSS_TRANSITION($1)
        match /transition-duration\s*:\s*([^;]+);/ -> emit CSS_DURATION($1)
        match /transition-timing-function\s*:\s*([^;]+);/ -> emit CSS_TIMING($1)
    }

    # Transform detection
    rule "transforms" {
        match /transform\s*:\s*([^;]+);/ -> emit CSS_TRANSFORM($1)
        if contains "translate" -> emit TRANSFORM_TRANSLATE
        if contains "rotate" -> emit TRANSFORM_ROTATE
        if contains "scale" -> emit TRANSFORM_SCALE
        if contains "skew" -> emit TRANSFORM_SKEW
        if contains "matrix" -> emit TRANSFORM_MATRIX
        if contains "3d" -> emit TRANSFORM_3D
    }

    # Layout detection
    rule "layout" {
        match /display\s*:\s*flex/ -> emit LAYOUT_FLEXBOX
        match /display\s*:\s*grid/ -> emit LAYOUT_GRID
        match /position\s*:\s*fixed/ -> emit LAYOUT_FIXED
        match /position\s*:\s*sticky/ -> emit LAYOUT_STICKY
    }

    # CSS Variables
    rule "variables" {
        match /--([a-zA-Z0-9_-]+)\s*:\s*([^;]+);/ -> emit CSS_VAR($1, $2)
        match /var\s*\(\s*--([a-zA-Z0-9_-]+)/ -> emit CSS_VAR_USAGE($1)
    }

    # Visual effects
    rule "effects" {
        match /box-shadow\s*:\s*([^;]+);/ -> emit CSS_SHADOW($1)
        match /filter\s*:\s*([^;]+);/ -> emit CSS_FILTER($1)
        match /backdrop-filter\s*:\s*([^;]+);/ -> emit CSS_BACKDROP($1)
        match /clip-path\s*:\s*([^;]+);/ -> emit CSS_CLIPPATH($1)
        match /mix-blend-mode\s*:\s*([^;]+);/ -> emit CSS_BLEND($1)
    }

    # Pseudo states
    rule "states" {
        match /([^{]+):hover\s*\{([^}]+)\}/ -> emit CSS_HOVER($1, $2)
        match /([^{]+):focus\s*\{([^}]+)\}/ -> emit CSS_FOCUS($1, $2)
        match /([^{]+):active\s*\{([^}]+)\}/ -> emit CSS_ACTIVE($1, $2)
    }

    # Media queries
    rule "media" {
        match /@media\s*\(([^)]+)\)/ -> emit CSS_MEDIA($1)
        if contains "prefers-reduced-motion" -> emit CSS_REDUCED_MOTION
        if contains "prefers-color-scheme" -> emit CSS_COLOR_SCHEME
    }
}

@js {
    # Animation libraries
    rule "animation_libs" {
        match /gsap\.(\w+)/ -> emit LIB_GSAP($1)
        match /TweenMax\.(\w+)/ -> emit LIB_TWEENMAX($1)
        match /anime\s*\(/ -> emit LIB_ANIMEJS
        match /motion\.(\w+)/ -> emit LIB_FRAMER($1)
        match /Velocity\s*\(/ -> emit LIB_VELOCITY
        match /lottie\.(\w+)/ -> emit LIB_LOTTIE($1)
    }

    # 3D libraries
    rule "3d_libs" {
        match /THREE\.(\w+)/ -> emit LIB_THREEJS($1)
        match /BABYLON\.(\w+)/ -> emit LIB_BABYLON($1)
        match /PIXI\.(\w+)/ -> emit LIB_PIXI($1)
        match /AFRAME\.(\w+)/ -> emit LIB_AFRAME($1)
    }

    # WebGL detection
    rule "webgl" {
        match /getContext\s*\(\s*['"]webgl['"]/ -> emit WEBGL_CONTEXT
        match /getContext\s*\(\s*['"]webgl2['"]/ -> emit WEBGL2_CONTEXT
        match /WebGLRenderingContext/ -> emit WEBGL_RENDERING
        match /createShader\s*\(/ -> emit WEBGL_SHADER
        match /shaderSource\s*\(/ -> emit WEBGL_SHADERSRC
        match /compileShader\s*\(/ -> emit WEBGL_COMPILE
    }

    # WebGPU detection
    rule "webgpu" {
        match /navigator\.gpu/ -> emit WEBGPU_NAVIGATOR
        match /GPUDevice/ -> emit WEBGPU_DEVICE
        match /GPUBuffer/ -> emit WEBGPU_BUFFER
        match /createShaderModule/ -> emit WEBGPU_SHADER
    }

    # Scroll libraries
    rule "scroll_libs" {
        match /LocomotiveScroll/ -> emit LIB_LOCOMOTIVE
        match /ScrollMagic/ -> emit LIB_SCROLLMAGIC
        match /ScrollTrigger/ -> emit LIB_SCROLLTRIGGER
        match /AOS\.init/ -> emit LIB_AOS
        match /Lenis/ -> emit LIB_LENIS
    }

    # Native animation APIs
    rule "native_animation" {
        match /requestAnimationFrame\s*\(/ -> emit API_RAF
        match /cancelAnimationFrame\s*\(/ -> emit API_CAF
        match /\.animate\s*\(\s*\[/ -> emit API_WAAPI
    }

    # Observers
    rule "observers" {
        match /IntersectionObserver/ -> emit API_INTERSECTION
        match /MutationObserver/ -> emit API_MUTATION
        match /ResizeObserver/ -> emit API_RESIZE
    }

    # UI Frameworks
    rule "frameworks" {
        match /React\.(\w+)/ -> emit FW_REACT($1)
        match /Vue\.(\w+)/ -> emit FW_VUE($1)
        match /angular/ -> emit FW_ANGULAR
        match /__NEXT/ -> emit FW_NEXTJS
        match /__NUXT/ -> emit FW_NUXT
        match /svelte/ -> emit FW_SVELTE
    }

    # Event handlers
    rule "events" {
        match /addEventListener\s*\(\s*['"]scroll['"]/ -> emit EVT_SCROLL
        match /addEventListener\s*\(\s*['"]mousemove['"]/ -> emit EVT_MOUSEMOVE
        match /addEventListener\s*\(\s*['"]touchstart['"]/ -> emit EVT_TOUCH
        match /addEventListener\s*\(\s*['"]wheel['"]/ -> emit EVT_WHEEL
    }
}

@html {
    # UI Components
    rule "components" {
        find class="modal" -> emit UI_MODAL
        find class="dialog" -> emit UI_DIALOG
        find class="dropdown" -> emit UI_DROPDOWN
        find class="carousel" -> emit UI_CAROUSEL
        find class="slider" -> emit UI_SLIDER
        find class="tabs" -> emit UI_TABS
        find class="accordion" -> emit UI_ACCORDION
        find class="nav" -> emit UI_NAV
        find class="sidebar" -> emit UI_SIDEBAR
    }

    # Media elements
    rule "media" {
        find tag="canvas" -> emit MEDIA_CANVAS
        find tag="video" -> emit MEDIA_VIDEO
        find tag="audio" -> emit MEDIA_AUDIO
        find tag="svg" -> emit MEDIA_SVG
        find tag="iframe" -> emit MEDIA_IFRAME
    }

    # Interactive elements
    rule "interactive" {
        find tag="button" -> emit INTERACTIVE_BUTTON
        find tag="input" -> emit INTERACTIVE_INPUT
        find tag="select" -> emit INTERACTIVE_SELECT
        find tag="textarea" -> emit INTERACTIVE_TEXTAREA
    }

    # Semantic structure
    rule "semantic" {
        find tag="header" -> emit SEM_HEADER
        find tag="footer" -> emit SEM_FOOTER
        find tag="main" -> emit SEM_MAIN
        find tag="nav" -> emit SEM_NAV
        find tag="article" -> emit SEM_ARTICLE
        find tag="section" -> emit SEM_SECTION
        find tag="aside" -> emit SEM_ASIDE
    }

    # Data attributes
    rule "data_attrs" {
        match /data-aos=['"]([^'"]+)['"]/ -> emit DATA_AOS($1)
        match /data-scroll/ -> emit DATA_SCROLL
        match /data-animate/ -> emit DATA_ANIMATE
    }
}
