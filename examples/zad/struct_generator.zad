// ZAD Example: Generate struct definitions for multiple languages
// Usage: zad compile struct_generator.zad --target rust

template struct_def(name: string, fields: list) {
    pub struct {name} {
        @indent
        for (fields) |field| {
            pub {field.name}: {field.type},
        }
        @dedent
    }
}

template field(name: string, type: string) {
    {name}: {type}
}

// Example usage
@use struct_def("User", [
    {name: "id", type: "u64"},
    {name: "username", type: "String"},
    {name: "email", type: "String"},
    {name: "created_at", type: "DateTime"}
])
