// ZAD Example: Generate API route definitions
// This demonstrates loops, conditionals, and template composition

template route(method: string, path: string, handler: string) {
    @raw
    router.{lower(method)}("{path}", {handler});
}

template resource(name: string, base_path: string) {
    // CRUD routes for {name}
    @use route("GET", "{base_path}", "list_{lower(name)}s")
    @use route("GET", "{base_path}/:id", "get_{lower(name)}")
    @use route("POST", "{base_path}", "create_{lower(name)}")
    @use route("PUT", "{base_path}/:id", "update_{lower(name)}")
    @use route("DELETE", "{base_path}/:id", "delete_{lower(name)}")
}

template api_router(resources: list) {
    const router = express.Router();

    @indent
    for (resources) |res| {
        @use resource(res.name, res.path)
        @newline
    }
    @dedent

    export default router;
}

// Generate API routes
@use api_router([
    {name: "User", path: "/api/users"},
    {name: "Post", path: "/api/posts"},
    {name: "Comment", path: "/api/comments"}
])
